# .env.example

# This file is a template for local environment configuration.
# Copy it to `.env` and set values securely.

GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional runtime settings
AERYN_LOG_LEVEL=INFO
AERYN_DATA_DIR=./data
AERYN_DB_PATH=./data/aeryn.db
AERYN_TIMEOUT_SECONDS=120
AERYN_MAX_RETRIES=3

# Android-specific settings (used by companion or runtime bootstrap)
ANDROID_PACKAGE_NAME=com.aeryn.agent
ANDROID_FOREGROUND_SERVICE_NAME=AerynForegroundService
